# ============================================================
# ezBookkeeping + Litestream Docker Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ============================================================
# Docker / Port Configuration
# ============================================================

# Host port to map to ezBookkeeping's HTTP port (default: 8080)
EBK_HTTP_PORT=8080

# ============================================================
# ezBookkeeping Application Configuration
# ============================================================

# Override any ezbookkeeping.ini setting via environment variables.
# Format: EBK_<SECTION>_<KEY>   (all uppercase)
#
# Example: override the secret_key in [security] section:
#   EBK_SECURITY_SECRET_KEY=your-generated-secret
#
# MUST change secret_key before first run to keep user data safe.
# Generate one: openssl rand -base64 32

# ============================================================
# Litestream Replication (SQLite continuous backup)
# See https://litestream.io/guides/
# ============================================================

# Set the replica URL for Litestream replication.
# Leave empty to disable Litestream entirely.
#
# --- Cloudflare R2 Examples ---
#   s3://my-bucket/ezbookkeeping/db
#     (with LITESTREAM_ENDPOINT set to your R2 endpoint)
#
# --- Other S3-compatible storage ---
#   s3://my-bucket/path/to/replica
#   s3://custom-endpoint:443/mybucket/path
#
# --- Local filesystem (dev only) ---
#   file:///ezbookkeeping/data/backup
LITESTREAM_REPLICA_URL=

# S3 access key ID (required for S3-compatible storage like R2)
# For Cloudflare R2: use your R2 Access Key ID
LITESTREAM_ACCESS_KEY_ID=

# S3 secret access key (required for S3-compatible storage like R2)
# For Cloudflare R2: use your R2 Secret Access Key
LITESTREAM_SECRET_ACCESS_KEY=

# S3 region (default: auto)
# For Cloudflare R2: use "auto"
LITESTREAM_REGION=auto

# S3 custom endpoint (required for S3-compatible storage like R2)
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Find your Account ID in the R2 dashboard.
LITESTREAM_ENDPOINT=

# Automatically restore database from replica when local DB is missing.
# Set to "false" to always start with a fresh database.
LITESTREAM_RESTORE_IF_DB_MISSING=true

# Path to the SQLite database file (must match db_path in ezbookkeeping.ini)
LITESTREAM_DB_PATH=/ezbookkeeping/data/ezbookkeeping.db
